---
// ContactCard.astro - Contact info card
---

<div class="contact-inner">
  <div class="contact-label">CONTACT ME</div>
  <div class="contact-list">
    <div class="contact-item">
      <span class="contact-icon">🐧</span>
      <span class="contact-key">QQ</span>
      <span class="contact-val">964911909</span>
    </div>
    <div class="contact-item">
      <span class="contact-icon">📮</span>
      <span class="contact-key">QQ Mail</span>
      <a class="contact-val contact-link" href="mailto:964911909@qq.com">964911909@qq.com</a>
    </div>
    <div class="contact-item">
      <span class="contact-icon">📧</span>
      <span class="contact-key">Gmail</span>
      <a class="contact-val contact-link" href="mailto:hzcugyn@gmail.com">hzcugyn@gmail.com</a>
    </div>
  </div>
</div>

<style is:global>
  .contact-inner {
    padding: 20px 26px 18px;
  }

  .contact-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--primary);
    font-weight: 700;
    font-family: var(--font-code);
    margin-bottom: 14px;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
  }

  .contact-icon {
    font-size: 1rem;
    width: 24px;
    text-align: center;
    flex-shrink: 0;
  }

  .contact-key {
    font-size: 0.72rem;
    color: var(--text-secondary);
    opacity: 0.6;
    min-width: 52px;
    flex-shrink: 0;
    font-weight: 600;
  }

  .contact-val {
    color: var(--text);
    font-family: var(--font-code);
    font-size: 0.8rem;
  }

  .contact-link {
    transition: color 0.2s;
  }

  .contact-link:hover {
    color: var(--primary);
  }
</style>
