---
// ArticleCard.astro - Latest blog post preview
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts[0];
const dateStr = latest?.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

{latest ? (
  <a href={`${base}blog/${latest.id}`} class="article-inner">
    <div class="article-label">Latest Post</div>
    <h3 class="article-title">{latest.data.title}</h3>
    <p class="article-desc">{latest.data.description}</p>
    <time class="article-date">{dateStr}</time>
  </a>
) : (
  <div class="article-inner">
    <div class="article-label">Latest Post</div>
    <p class="article-desc">No posts yet.</p>
  </div>
)}

<style>
  .article-inner {
    display: flex;
    flex-direction: column;
    padding: 24px;
    height: 100%;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s;
  }

  a.article-inner:hover {
    color: var(--text);
  }

  a.article-inner:hover .article-title {
    color: var(--primary);
  }

  .article-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .article-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 6px;
    transition: color 0.2s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 8px;
  }
</style>
