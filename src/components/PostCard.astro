---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  cover?: string;
}

const { title, description, pubDate, tags, slug, cover } = Astro.props;
const dateStr = pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<a href={`/blog/${slug}`} class="post-card">
  {cover && <img src={`/covers/${cover}`} alt={title} class="post-cover" loading="lazy" />}
  <div class="post-card-body">
    <time class="post-date">{dateStr}</time>
    <h3 class="post-title">{title}</h3>
    <p class="post-desc">{description}</p>
    <div class="post-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .post-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--card-bg);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    color: var(--text);
  }
  .post-cover {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .post-card-body {
    padding: 1.25rem;
  }
  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .post-title {
    font-size: 1.125rem;
    margin-top: 0.5rem;
    line-height: 1.4;
  }
  .post-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    line-height: 1.6;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    background: var(--bg);
    color: var(--accent);
    border: 1px solid var(--border);
  }
</style>
