---
// Card.astro - Frosted glass card wrapper with entrance animation

interface Props {
  width?: string;
  height?: string;
  order?: number;
  class?: string;
  href?: string;
}

const { width, height, order = 0, class: className = '', href } = Astro.props;

const style = [
  width ? `width: ${width}` : '',
  height ? `height: ${height}` : '',
].filter(Boolean).join('; ');

const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['card', 'card-animate', `card-delay-${order}`, 'card-hover', className]}
  style={style}
  href={href}
>
  <slot />
</Tag>

<style>
  .card-hover {
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .card-hover:hover {
    transform: scale(1.02);
  }

  .card-hover:active {
    transform: scale(0.98);
  }

  a.card-hover {
    color: inherit;
    text-decoration: none;
  }
</style>
