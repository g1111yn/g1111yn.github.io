---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About me">
  <div class="container about-page">
    <h1>About</h1>
    <div class="about-content">
      <p>Hi, I'm <strong>Your Name</strong>.</p>
      <p>写代码，也写生活。这里记录技术思考和日常碎片。</p>

      <h2>Links</h2>
      <ul>
        <li><a href="https://github.com/USERNAME" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 3rem 1.5rem;
    max-width: 680px;
  }
  .about-page h1 {
    margin-bottom: 2rem;
  }
  .about-content p {
    margin-bottom: 1.25rem;
  }
  .about-content h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .about-content ul {
    padding-left: 1.5rem;
  }
  .about-content li {
    margin-bottom: 0.5rem;
  }
</style>
