---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Stats
const totalPosts = posts.length;
const allTags = posts.flatMap(p => p.data.tags);
const totalTags = new Set(allTags).size;

// Category definitions with icons and colors
const categories = [
  { name: '技术', icon: '💻', color: '#3b82f6', desc: '代码与工程' },
  { name: '生活', icon: '🌿', color: '#22c55e', desc: '日常点滴' },
  { name: '随笔', icon: '✏️', color: '#f59e0b', desc: '所思所想' },
  { name: '杂', icon: '📦', color: '#8b5cf6', desc: '未分类' },
];

// Count posts per category (match by tag)
const catCounts = categories.map(cat => ({
  ...cat,
  count: posts.filter(p => p.data.tags.includes(cat.name)).length,
}));

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<string, typeof posts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---
<BaseLayout title="Blog" description="All blog posts">
  <div class="blog-page">

    <!-- ===== Hero Header ===== -->
    <div class="blog-hero card card-animate card-delay-0">
      <div class="hero-left">
        <h1>Blog</h1>
        <p class="hero-desc">写代码，也写生活</p>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">{totalPosts}</span>
          <span class="stat-label">Posts</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">{totalTags}</span>
          <span class="stat-label">Tags</span>
        </div>
      </div>
    </div>

    <!-- ===== Category Cards ===== -->
    <div class="blog-cats">
      {catCounts.map((cat, i) => (
        <a
          href={cat.count > 0 ? `/blog/tags/${cat.name}/` : '#'}
          class:list={['cat-card', 'card', 'card-animate', `card-delay-${i + 1}`]}
        >
          <span class="cat-icon">{cat.icon}</span>
          <span class="cat-name">{cat.name}</span>
          <span class="cat-count">{cat.count}</span>
        </a>
      ))}
    </div>

    <!-- ===== Timeline (preserved) ===== -->
    <div class="blog-timeline card card-animate card-delay-5">
      {years.map(year => (
        <div class="year-group">
          <div class="year-label">{year}</div>
          <div class="posts-list">
            {postsByYear[year].map((post, i) => {
              const dateStr = post.data.pubDate.toLocaleDateString('zh-CN', {
                month: 'short',
                day: 'numeric',
              });
              return (
                <a href={`/blog/${post.id}`} class="post-row" style={`animation-delay: ${(i + 2) * 50}ms`}>
                  <span class="post-dot"></span>
                  <time class="post-date">{dateStr}</time>
                  <span class="post-title">{post.data.title}</span>
                  <div class="post-tags-inline">
                    {post.data.tags.slice(0, 2).map(tag => (
                      <span class="post-tag">{tag}</span>
                    ))}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .blog-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }

  /* ===== Hero ===== */
  .blog-hero {
    padding: 36px 32px 28px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .blog-hero h1 {
    font-size: 2rem;
    font-family: var(--font-display);
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
  }

  .hero-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-code);
    color: var(--primary);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.65rem;
    color: var(--text-secondary);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stat-divider {
    width: 1px;
    height: 28px;
    background: var(--text-secondary);
    opacity: 0.15;
    transform: rotate(15deg);
  }

  /* ===== Category Cards ===== */
  .blog-cats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 18px 12px 14px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
    cursor: pointer;
  }

  .cat-card:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 24px rgba(53, 191, 171, 0.1);
    color: var(--text);
  }

  .cat-icon {
    font-size: 1.5rem;
    line-height: 1;
    margin-bottom: 2px;
  }

  .cat-name {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .cat-count {
    font-size: 0.68rem;
    color: var(--text-secondary);
    opacity: 0.5;
    font-family: var(--font-code);
  }

  /* ===== Timeline ===== */
  .blog-timeline {
    padding: 28px 32px;
  }

  .year-group {
    margin-bottom: 2rem;
  }

  .year-group:last-child {
    margin-bottom: 0;
  }

  .year-label {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 12px;
    font-family: var(--font-display);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 2px solid rgba(53, 191, 171, 0.15);
    margin-left: 6px;
    padding-left: 20px;
  }

  .post-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    position: relative;
    animation: fadeInUp 0.4s ease both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-row:hover {
    background: rgba(53, 191, 171, 0.06);
  }

  .post-dot {
    position: absolute;
    left: -27px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--primary);
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .post-row:hover .post-dot {
    background: var(--primary);
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    min-width: 50px;
    flex-shrink: 0;
  }

  .post-title {
    font-size: 0.95rem;
    font-weight: 500;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-tags-inline {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .post-tag {
    font-size: 0.65rem;
    padding: 2px 8px;
    border-radius: 10px;
    background: rgba(53, 191, 171, 0.08);
    color: var(--primary);
    white-space: nowrap;
  }

  /* ===== Mobile ===== */
  @media (max-width: 640px) {
    .blog-page {
      padding: 0 16px 40px;
    }

    .blog-hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 28px 20px 20px;
    }

    .blog-cats {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .blog-timeline {
      padding: 20px 16px;
    }

    .post-tags-inline {
      display: none;
    }

    .post-row {
      gap: 8px;
    }
  }
</style>
