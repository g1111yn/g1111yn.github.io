---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap(post => post.data.tags))];
  return tags.map(tag => ({
    params: { tag },
    props: {
      posts: posts
        .filter(post => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged with ${tag}`}>
  <div class="tag-page">
    <div class="tag-header card card-animate card-delay-0">
      <h1 class="text-linear">#{tag}</h1>
      <p class="tag-count">{posts.length} post{posts.length > 1 ? 's' : ''}</p>
      <a href={`${base}blog/`} class="back-link">&larr; All posts</a>
    </div>

    <div class="tag-posts card card-animate card-delay-1">
      {posts.map((post, i) => {
        const dateStr = post.data.pubDate.toLocaleDateString('zh-CN', {
          month: 'short',
          day: 'numeric',
        });
        return (
          <a href={`/blog/${post.id}`} class="post-row">
            <time class="post-date">{dateStr}</time>
            <span class="post-title">{post.data.title}</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .tag-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }

  .tag-header {
    padding: 40px 32px 28px;
    margin-bottom: 16px;
  }

  .tag-header h1 {
    font-size: 2rem;
    font-family: var(--font-display);
    margin-bottom: 4px;
  }

  .tag-count {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .back-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--primary);
    padding: 4px 12px;
    border-radius: 12px;
    background: rgba(53, 191, 171, 0.06);
    transition: background 0.2s;
  }

  .back-link:hover {
    background: rgba(53, 191, 171, 0.12);
    color: var(--primary);
  }

  .tag-posts {
    padding: 20px 28px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    transition: background 0.2s;
  }

  .post-row:hover {
    background: rgba(53, 191, 171, 0.06);
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    min-width: 50px;
    flex-shrink: 0;
  }

  .post-title {
    font-size: 0.95rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .tag-page {
      padding: 0 16px 40px;
    }
    .tag-header {
      padding: 28px 20px 20px;
    }
    .tag-posts {
      padding: 16px 16px;
    }
  }
</style>
