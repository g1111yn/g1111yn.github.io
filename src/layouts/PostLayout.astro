---
import BaseLayout from './BaseLayout.astro';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
}

const { title, description, pubDate, updatedDate, tags, headings, prevPost, nextPost } = Astro.props;

const pubDateStr = pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedDateStr = updatedDate?.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---
<BaseLayout title={title} description={description}>
  <div class="post-page">
    <!-- Main Article -->
    <article class="post-content card card-animate card-delay-0">
      <div class="post-article-inner">
        <header class="post-header">
          <h1>{title}</h1>
          <div class="post-meta">
            <time>{pubDateStr}</time>
            {updatedDate && <span>· Updated: {updatedDateStr}</span>}
          </div>
          <div class="post-tags">
            {tags.map(tag => (
              <a href={`/blog/tags/${tag}`} class="tag">{tag}</a>
            ))}
          </div>
        </header>

        <div class="prose">
          <slot />
        </div>

        <nav class="post-nav">
          {prevPost && <a href={`/blog/${prevPost.slug}`} class="nav-prev">&larr; {prevPost.title}</a>}
          {nextPost && <a href={`/blog/${nextPost.slug}`} class="nav-next">{nextPost.title} &rarr;</a>}
        </nav>
      </div>
    </article>

    <!-- Floating TOC Sidebar -->
    {tocHeadings.length > 0 && (
      <aside class="post-toc-float" id="toc-float">
        <div class="toc-card card card-animate card-delay-1" id="toc">
          <div class="toc-header">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 6h16"/>
              <path d="M4 12h12"/>
              <path d="M4 18h8"/>
            </svg>
            <span>Contents</span>
          </div>
          <div class="toc-progress" id="toc-progress">
            <div class="toc-progress-bar" id="toc-progress-bar"></div>
          </div>
          <ul>
            {tocHeadings.map(h => (
              <li class:list={[`toc-depth-${h.depth}`]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>

        <button class="scroll-top-btn card card-animate card-delay-2" id="scroll-top" title="Back to top">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 15-6-6-6 6"/>
          </svg>
        </button>
      </aside>
    )}
  </div>
</BaseLayout>

<style is:global>
  /* ===== Post Page Container ===== */
  .post-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 24px 80px;
    position: relative;
  }

  /* ===== Article Card ===== */
  .post-content {
    background: var(--bg-article);
    border-radius: 28px;
  }

  .post-article-inner {
    padding: 48px 52px;
  }

  /* ===== Article Header ===== */
  .post-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    font-family: var(--font-code);
    opacity: 0.7;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .post-tags .tag {
    font-size: 0.72rem;
    padding: 0.2em 0.7em;
    border-radius: 10px;
    background: rgba(53, 191, 171, 0.08);
    color: var(--primary);
    transition: background 0.2s;
    font-weight: 500;
  }

  .post-tags .tag:hover {
    background: rgba(53, 191, 171, 0.15);
    color: var(--primary);
  }

  /* ===== Post Navigation ===== */
  .post-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  html.dark .post-nav {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .nav-prev, .nav-next {
    font-size: 0.88rem;
    color: var(--text-secondary);
    max-width: 45%;
    transition: color 0.2s, transform 0.15s;
  }

  .nav-prev:hover, .nav-next:hover {
    color: var(--primary);
    transform: translateX(2px);
  }

  .nav-prev:hover {
    transform: translateX(-2px);
  }

  .nav-next {
    margin-left: auto;
    text-align: right;
  }

  /* ===== Floating TOC Sidebar ===== */
  .post-toc-float {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    right: max(calc((100vw - 780px) / 2 - 240px), 20px);
    width: 200px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 50;
    transition: opacity 0.3s, transform 0.3s;
  }

  .post-toc-float.toc-hidden {
    opacity: 0;
    transform: translateY(-50%) translateX(10px);
    pointer-events: none;
  }

  /* ===== TOC Card ===== */
  .toc-card {
    padding: 18px 20px;
    border-radius: 20px;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary);
    font-family: var(--font-code);
    margin-bottom: 8px;
  }

  .toc-header svg {
    opacity: 0.7;
    color: var(--primary);
  }

  /* Reading Progress */
  .toc-progress {
    height: 2px;
    background: rgba(53, 191, 171, 0.1);
    border-radius: 2px;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .toc-progress-bar {
    height: 100%;
    background: var(--gradient-brand);
    border-radius: 2px;
    width: 0%;
    transition: width 0.15s ease;
  }

  .toc-card ul {
    list-style: none;
  }

  .toc-card li {
    margin-bottom: 3px;
  }

  .toc-card a {
    font-size: 0.76rem;
    color: var(--text-secondary);
    transition: color 0.2s, padding-left 0.2s, border-left-color 0.2s;
    display: block;
    line-height: 1.6;
    padding: 3px 0 3px 10px;
    border-left: 2px solid transparent;
    border-radius: 0 4px 4px 0;
  }

  .toc-card a:hover {
    color: var(--primary);
    padding-left: 14px;
  }

  .toc-card a.active {
    color: var(--primary);
    border-left-color: var(--primary);
    font-weight: 600;
    padding-left: 14px;
  }

  .toc-depth-3 a {
    padding-left: 22px;
    font-size: 0.72rem;
  }

  .toc-depth-3 a:hover,
  .toc-depth-3 a.active {
    padding-left: 26px;
  }

  /* ===== Scroll to Top ===== */
  .scroll-top-btn {
    width: 40px;
    height: 40px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-secondary);
    transition: color 0.2s, transform 0.2s, box-shadow 0.2s;
    font-size: 0;
    align-self: center;
    background: var(--card-bg);
    backdrop-filter: var(--card-blur);
    -webkit-backdrop-filter: var(--card-blur);
  }

  .scroll-top-btn:hover {
    color: var(--primary);
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 4px 12px rgba(53, 191, 171, 0.15);
  }

  /* ===== Responsive ===== */
  @media (max-width: 1200px) {
    .post-toc-float {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .post-page {
      padding: 0 16px 40px;
    }
    .post-article-inner {
      padding: 28px 22px;
    }
    .post-content {
      border-radius: 24px;
    }
    .post-header h1 {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // TOC active highlighting with smooth scroll tracking
  const tocLinks = document.querySelectorAll('.toc-card a');
  const headingEls = Array.from(tocLinks).map(link => {
    const id = link.getAttribute('href')?.slice(1);
    return id ? document.getElementById(id) : null;
  }).filter(Boolean) as HTMLElement[];

  // Track active heading
  let currentActive: Element | null = null;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove('active'));
          const active = document.querySelector(`.toc-card a[href="#${entry.target.id}"]`);
          if (active) {
            active.classList.add('active');
            currentActive = active;
          }
        }
      });
    },
    { rootMargin: '-80px 0px -65% 0px' }
  );

  headingEls.forEach(h => observer.observe(h));

  // Reading progress bar
  const progressBar = document.getElementById('toc-progress-bar');
  const article = document.querySelector('.post-content');

  function updateProgress() {
    if (!progressBar || !article) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const current = -rect.top;
    const pct = Math.min(Math.max(current / total, 0), 1) * 100;
    progressBar.style.width = `${pct}%`;
  }

  // Show/hide TOC based on scroll position
  const tocFloat = document.getElementById('toc-float');

  function updateTocVisibility() {
    if (!tocFloat || !article) return;
    const rect = article.getBoundingClientRect();
    const isVisible = rect.top < window.innerHeight * 0.3 && rect.bottom > window.innerHeight * 0.3;
    tocFloat.classList.toggle('toc-hidden', !isVisible);
  }

  window.addEventListener('scroll', () => {
    updateProgress();
    updateTocVisibility();
  }, { passive: true });

  updateProgress();
  updateTocVisibility();

  // Scroll to top button
  document.getElementById('scroll-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
